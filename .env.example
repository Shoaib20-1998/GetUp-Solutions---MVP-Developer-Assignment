# Copy to .env and replace placeholders. Never commit the real .env.

# PostgreSQL connection string used by the API and by Alembic.
DATABASE_URL=postgresql+psycopg://ticketing:ticketing@postgres:5432/ticketing

# Signing key for JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-32-byte-hex-string

# Token lifetime in minutes.
JWT_EXPIRY_MINUTES=60

# Leave blank to use the deterministic mock AI provider (no cost, no key
# needed). Set to a free Gemini API key (https://ai.google.dev, Google AI
# Studio) to use a real LLM for triage instead. If the Gemini call fails for
# any reason (network, rate limit, bad response), the app automatically
# retries with the mock provider, so a suggestion is still shown.
AI_API_KEY=
AI_MODEL=gemini-flash-lite-latest

# Attachment limits. 5 MiB default.
MAX_ATTACHMENT_BYTES=5242880
ALLOWED_ATTACHMENT_TYPES=image/png,image/jpeg,application/pdf,text/plain
